{
	"name": "out-of-office",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:app": "cross-env BUILD_TARGET=app vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang || echo ''",
		"check": "paraglide-js compile --project ./project.inlang && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && npm run check:i18n && node scripts/build-email-templates.ts --check",
		"format": "prettier --write .",
		"gen": "node -e \"fs.rmSync('.svelte-kit/cloudflare',{recursive:true,force:true})\" && wrangler types",
		"import:osm": "node --env-file=.env scripts/import-osm.ts",
		"check:secrets": "node --env-file-if-exists=.env scripts/check-secrets.ts",
		"db:types": "npx supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
		"check:i18n": "node scripts/check-i18n.ts",
		"i18n:export": "node scripts/export-translations.ts",
		"i18n:approve": "node scripts/approve-translations.ts",
		"functions:secrets": "node scripts/functions-secrets.ts",
		"email:build": "node scripts/build-email-templates.ts",
		"map:style": "node scripts/build-map-style.ts && prettier --write src/lib/map/style.json",
		"dev:fixtures": "node --env-file=.env scripts/dev-fixtures.ts",
		"dev:grants": "node --env-file=.env scripts/dev-grants.ts",
		"dev:founding": "node --env-file=.env scripts/dev-founding.ts",
		"test": "vitest run",
		"test:db": "vitest run --config vitest.db.config.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "2.26.0",
		"@inlang/plugin-message-format": "4.4.5",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"cross-env": "^10.1.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"standardwebhooks": "1.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.2",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@supabase/supabase-js": "^2.117.2",
		"maplibre-gl": "^6.11.2"
	}
}
