	"city_not_in_area_body": "We open cities one at a time, with places checked by people who work there.",
	"launch_title": "We're just getting started here",
	"launch_counts": [
		{
			"declarations": [
				"input certified",
				"input checked",
				"input city",
				"local certifiedPlural = certified: plural",
				"local checkedPlural = checked: plural",
				"local certifiedText = certified: number",
				"local checkedText = checked: number"
			],
			"selectors": ["certifiedPlural", "checkedPlural"],
			"match": {
				"certifiedPlural=one, checkedPlural=one": "{certifiedText} certified and {checkedText} checked in {city}.",
				"certifiedPlural=one, checkedPlural=*": "{certifiedText} certified and {checkedText} checked in {city}.",
				"certifiedPlural=*, checkedPlural=one": "{certifiedText} certified and {checkedText} checked in {city}.",
				"certifiedPlural=*, checkedPlural=*": "{certifiedText} certified and {checkedText} checked in {city}."
			}
		}
	],
	"launch_waiting": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} more place is waiting for someone to try it.",
				"countPlural=*": "{countText} more places are waiting for someone to try them."
			}
		}
	],
