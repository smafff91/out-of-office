# Copy to .env and fill in (Supabase dashboard → Project Settings → API).
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where sign-in returns (Google and the email link). Development: the Vite dev server.
PUBLIC_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Google sign-in, read by `npx supabase config push` (supabase/config.toml). Never PUBLIC_.
# Google Cloud Console → Google Auth Platform → Clients.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Optional in development: Resend as SMTP ([auth.email.smtp] in supabase/config.toml).
# RESEND_API_KEY=re_...

# Scripts only (scripts/import-osm.ts). Never add the PUBLIC_ prefix, never read it from src/.
# Supabase dashboard → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_...
# Development project ref (the part before .supabase.co in PUBLIC_SUPABASE_URL).
# scripts/dev-fixtures.ts refuses to run against any other project.
DEV_PROJECT_REF=
# Contact sent in the User-Agent to Overpass, as its usage policy asks.
OSM_CONTACT=smafff91@gmail.com
# Optional: Overpass servers to try in order, comma separated.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
