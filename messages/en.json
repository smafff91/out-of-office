{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"common_search_placeholder": "Where to work today?",
	"common_certified": "Certified for remote work",
	"common_account": "Account",
	"common_map": "Map",
	"common_osm_attribution": "© OpenStreetMap contributors",
	"common_offline": "You're offline",
	"common_language": "Language",
	"place_score": "{percent} would work here again",
	"place_score_few": "{yes} of {total}",
	"place_votes": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} vote",
				"countPlural=*": "{countText} votes"
			}
		}
	],
	"place_confirmed_by": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "Confirmed by {countText} user",
				"countPlural=*": "Confirmed by {countText} users"
			}
		}
	],
	"place_certification_progress": [
		{
			"declarations": ["input count", "input total", "local totalPlural = total: plural"],
			"selectors": ["totalPlural"],
			"match": {
				"totalPlural=one": "{count} of {total} user to get certified",
				"totalPlural=*": "{count} of {total} users to get certified"
			}
		}
	],
	"place_no_work_info": "No work info yet",
	"place_walk_time": "{minutes} min walk",
	"place_open_until": "Open until {time}",
	"attribute_wifi_fast": "Fast Wi‑Fi",
	"attribute_outlets_plenty": "Plenty of outlets",
	"attribute_noise_quiet": "Quiet",
	"city_not_yet": "Not in {city} yet",
	"action_add_experience": "Add your experience",
	"action_report_problem": "Report a problem",
	"home_work_nearby": "Work nearby",
	"common_tiles_attribution": "OpenFreeMap © OpenMapTiles",
	"common_places_count": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} place",
				"countPlural=*": "{countText} places"
			}
		}
	],
	"common_certified_count": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} certified",
				"countPlural=*": "{countText} certified"
			}
		}
	],
	"action_dismiss": "Dismiss",
	"action_show_my_location": "Show my location",
	"action_use_my_location": "Use my location",
	"home_meta_title": "Cafés and bars to work from",
	"home_meta_description": "Find cafés and bars where you can work on your laptop, with Wi‑Fi, outlets and noise checked by users.",
	"home_intro": "Cafés and bars where you can work on your laptop, checked by people who work there.",
	"home_open_cities": "Open cities",
	"home_locating": "Finding where you are…",
	"city_meta_title": "Cafés to work from in {city}",
	"city_meta_description": "Cafés and bars in {city} where you can work on your laptop, with Wi‑Fi, outlets and noise checked by users.",
	"city_not_in_area": "We're not in your area yet",
	"city_not_in_area_body": "We open cities one at a time, with places checked by people who work there.",
	"launch_title": "We're just getting started here",
	"launch_counts": [
		{
			"declarations": [
				"input certified",
				"input checked",
				"input city",
				"local certifiedPlural = certified: plural",
				"local checkedPlural = checked: plural",
				"local certifiedText = certified: number",
				"local checkedText = checked: number"
			],
			"selectors": ["certifiedPlural", "checkedPlural"],
			"match": {
				"certifiedPlural=one, checkedPlural=one": "{certifiedText} certified and {checkedText} checked in {city}.",
				"certifiedPlural=one, checkedPlural=*": "{certifiedText} certified and {checkedText} checked in {city}.",
				"certifiedPlural=*, checkedPlural=one": "{certifiedText} certified and {checkedText} checked in {city}.",
				"certifiedPlural=*, checkedPlural=*": "{certifiedText} certified and {checkedText} checked in {city}."
			}
		}
	],
	"launch_waiting": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{countText} more place is waiting for someone to try it.",
				"countPlural=*": "{countText} more places are waiting for someone to try them."
			}
		}
	],
	"location_denied": "Location is off. You can turn it on in your browser settings.",
	"location_off_title": "Where are you working from?",
	"location_off_body": "Location is off, so we can't sort places by distance. Turn it on, or pick an area.",
	"location_areas_in": "Areas in {city}",
	"location_all_neighborhoods": "All neighborhoods",
	"location_unavailable": "We couldn't find your location. Try again in a moment.",
	"sort_label": "Sort by",
	"sort_nearest": "Nearest",
	"sort_top_rated": "Top rated",
	"list_not_enough_votes": "Not enough votes yet",
	"action_show_more": "Show more",
	"action_search_area": "Search this area",
	"place_opens_at": "Opens {time}",
	"place_closed_today": "Closed today",
	"place_open_24h": "Open 24 hours",
	"attribute_wifi_none": "No Wi‑Fi",
	"attribute_wifi_slow": "Slow Wi‑Fi",
	"attribute_outlets_none": "No outlets",
	"attribute_outlets_a_few": "A few outlets",
	"attribute_noise_noisy": "Noisy",
	"laptop_rule_no_laptops_lunch": "No laptops at lunch",
	"laptop_rule_no_laptops_weekends": "No laptops on weekends",
	"laptop_rule_time_limit": "Time limit for laptops",
	"sheet_collapsed": "List: collapsed. Tap to expand to half screen",
	"sheet_half": "List: half screen. Tap to expand to full screen",
	"sheet_full": "List: full screen. Tap to collapse",
	"certified_none_title": "No certified places around here yet",
	"certified_none_body": [
		{
			"declarations": [
				"input count",
				"local countPlural = count: plural",
				"local countText = count: number"
			],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "There is {countText} place nearby nobody has checked. Show it and help others find out if it's good for work.",
				"countPlural=*": "There are {countText} places nearby nobody has checked. Show them all and help others find out if they're good for work."
			}
		}
	],
	"action_show_all": "Show all places",
	"action_zoom_out_certified": "Zoom out to find certified places",
	"search_label": "Search places and neighborhoods",
	"search_neighborhoods": "Neighborhoods",
	"search_places": "Places",
	"search_no_results": "No places or neighborhoods match “{query}”",
	"action_back": "Back",
	"action_clear_search": "Clear search",
	"action_add_place": "Add a place",
	"action_sign_in": "Sign in",
	"map_zoom_in": "Zoom in",
	"map_zoom_out": "Zoom out"
}
