		{
			"declarations": [
				"input certified",
				"input checked",
				"input city",
				"local certifiedPlural = certified: plural",
				"local checkedPlural = checked: plural",
				"local certifiedText = certified: number",
				"local checkedText = checked: number"
			],
			"selectors": ["certifiedPlural", "checkedPlural"],
			"match": {
				"certifiedPlural=one, checkedPlural=one": "{certifiedText} certificado y {checkedText} revisado en {city}.",
				"certifiedPlural=one, checkedPlural=*": "{certifiedText} certificado y {checkedText} revisados en {city}.",
				"certifiedPlural=*, checkedPlural=one": "{certifiedText} certificados y {checkedText} revisado en {city}.",
				"certifiedPlural=*, checkedPlural=*": "{certifiedText} certificados y {checkedText} revisados en {city}."
			}
		}
	],
